<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared brand palette and control styles for all Govorun windows
         (onboarding wizard, history) — keeps the chrome-free rounded-card
         look consistent without duplicating it per window. -->

    <SolidColorBrush x:Key="BrandBlue" Color="#3A7AFE"/>
    <SolidColorBrush x:Key="BrandDeep" Color="#1F5AD8"/>
    <SolidColorBrush x:Key="BrandSky" Color="#5AC8FF"/>
    <SolidColorBrush x:Key="BrandInk" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="BrandMuted" Color="#61708F"/>

    <Style TargetType="Button" x:Key="BrandButton">
        <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="28,9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrandDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#B9C6E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless icon-style button, used for the window close button and
         the per-entry copy action in the history window. -->
    <Style TargetType="Button" x:Key="BrandIconButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrandMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#EDF2FC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented tab switcher (История / Настройки) — active/inactive look is
         toggled imperatively in code-behind, not via triggers. -->
    <Style TargetType="Button" x:Key="BrandTabButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrandMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#EDF2FC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
        <Setter Property="Background" Value="#E8EEFB"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Standard chrome-free window shell: rounded card + soft brand shadow. -->
    <Style TargetType="Border" x:Key="BrandWindowShell">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="#FBFCFF"/>
        <Setter Property="BorderBrush" Value="#D8E2F5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25" Color="#1F5AD8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="BrandHeaderUnderline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3A7AFE" Offset="0"/>
        <GradientStop Color="#5AC8FF" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
