<Window x:Class="Govorun.App.Onboarding.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать в Govorun" Width="560" Height="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/Brand.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource BrandWindowShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: logo + title + close, gradient underline -->
            <Grid Grid.Row="0" Margin="24,18,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0"
                       Source="pack://application:,,,/Assets/logo.png"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Govorun" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandInk}"/>
                    <TextBlock x:Name="StepTitle" FontSize="13" Foreground="{StaticResource BrandMuted}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="32" Height="32" Click="OnCloseClicked"
                        Style="{StaticResource BrandIconButton}" FontSize="14" VerticalAlignment="Top"/>
            </Grid>
            <Rectangle Grid.Row="1" Height="3" Margin="24,12,24,0" RadiusX="1.5" RadiusY="1.5"
                       Fill="{StaticResource BrandHeaderUnderline}"/>

            <!-- Step content -->
            <Grid Grid.Row="2" Margin="28,16,28,0">

                <!-- Step 1: microphone -->
                <StackPanel x:Name="StepMic" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource BrandInk}"
                               Text="Выберите микрофон и скажите что-нибудь. Когда мы услышим голос, шкала оживёт и мастер перейдёт дальше сам."/>
                    <ComboBox x:Name="MicCombo" Margin="0,0,0,12" SelectionChanged="OnMicDeviceChanged"/>
                    <ProgressBar x:Name="MicLevel" Height="14" Maximum="1"/>
                    <TextBlock x:Name="MicStatus" Margin="0,12,0,0" Foreground="{StaticResource BrandMuted}"
                               TextWrapping="Wrap" Text="Слушаем микрофон…"/>
                </StackPanel>

                <!-- Step 2: benchmark -->
                <StackPanel x:Name="StepBench" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="BenchStatus" TextWrapping="Wrap" Foreground="{StaticResource BrandInk}"
                               Text="Подбираем оптимальные параметры под ваш процессор…"/>
                    <ProgressBar x:Name="BenchProgress" Height="14" Margin="0,16,0,0" IsIndeterminate="True"/>
                </StackPanel>

                <!-- Step 3: controls (hotkey + activation mode) -->
                <Grid x:Name="StepHotkey" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="Горячая клавиша" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{StaticResource BrandInk}"/>
                        <RadioButton x:Name="HotkeyCtrlWin" Content="Ctrl + Win" GroupName="hk" IsChecked="True"
                                     Checked="OnControlChoiceChanged"/>
                        <RadioButton x:Name="HotkeyCtrlSpace" Content="Ctrl + Space" GroupName="hk"
                                     Checked="OnControlChoiceChanged"/>
                        <RadioButton x:Name="HotkeyDoubleCtrl" Content="Двойное нажатие Ctrl" GroupName="hk"
                                     Checked="OnControlChoiceChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="Режим записи" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{StaticResource BrandInk}"/>
                        <RadioButton x:Name="ModeHold" GroupName="act" IsChecked="True"
                                     Checked="OnControlChoiceChanged">
                            <TextBlock Text="Держу — запись, отпустил — стоп" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="ModeToggle" GroupName="act" Checked="OnControlChoiceChanged">
                            <TextBlock Text="Нажал — запись, ещё раз — стоп" TextWrapping="Wrap"/>
                        </RadioButton>
                    </StackPanel>
                    <TextBlock x:Name="ControlsHint" Grid.ColumnSpan="3" VerticalAlignment="Bottom"
                               TextWrapping="Wrap" Foreground="{StaticResource BrandMuted}" Margin="0,0,0,4"/>
                </Grid>

                <!-- Step 4: try it -->
                <StackPanel x:Name="StepMagic" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="MagicInstruction" TextWrapping="Wrap" Margin="0,0,0,14"
                               Foreground="{StaticResource BrandInk}"/>
                    <Border CornerRadius="10" BorderBrush="#C9D8F5" BorderThickness="1.5" Background="White">
                        <TextBox x:Name="MagicBox" Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="15" BorderThickness="0" Padding="10" Background="Transparent"/>
                    </Border>
                    <TextBlock x:Name="MagicStatus" Margin="0,14,0,0" Foreground="{StaticResource BrandBlue}"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="28,16,28,22">
                <StackPanel x:Name="StepDots" Orientation="Horizontal" VerticalAlignment="Center"/>
                <Button x:Name="NextButton" Content="Далее" Style="{StaticResource BrandButton}"
                        HorizontalAlignment="Right" Click="OnNextClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
